# Copy to .env and fill in. Never commit the real .env.

# --- Ports / service discovery ---
# Each service listens on its own PORT (the defaults below are what docker
# compose uses). Only the api-gateway is meant to be reachable from outside.
#   api-gateway 4000, authentication 4001, user 4002, property 4003, chat 4004, payment 4005
PORT=4000
# Where the gateway finds each service, and where services find each other.
# On Railway use the private network: http://<service>.railway.internal:<PORT>
AUTH_SERVICE_URL=http://localhost:4001
# Also read by authentication, which calls the user service directly when an
# account is deactivated or deleted.
USER_SERVICE_URL=http://localhost:4002
# Also read by user (cache notices, file erasure) and payment (publishing a listing).
PROPERTY_SERVICE_URL=http://localhost:4003
# Also read by user (cache notices, file erasure).
CHAT_SERVICE_URL=http://localhost:4004
PAYMENT_SERVICE_URL=http://localhost:4005
# Cache, rate limits and chat events shared between services and instances.
# Point every service at the SAME Redis (an external one in production).
REDIS_URL=redis://localhost:6379

# --- Security ---
# Browser origins allowed by CORS (comma-separated). Leave empty for mobile-only.
CORS_ORIGINS=
# RS256 key pair for access/refresh tokens. Generate with:
#   node scripts/generate-jwt-keys.js
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Signs the calls services make to each other (HS256, one minute each). The same
# value in user, property, chat and payment; at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTERNAL_SERVICE_SECRET=
# Shared secret used to sign payment webhooks. Webhooks are rejected without it.
PAYMENT_WEBHOOK_SECRET=
# Seals the chat key backups, so a copy of the database alone cannot be used to
# guess PINs. At least 32 characters; chat backups are refused without it.
# Changing or losing it makes every stored backup unreadable. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CHAT_BACKUP_SECRET=

# Where "Logged-in devices" looks up the city of an IP address. Empty uses
# https://ipwho.is (free, no key); "off" disables the lookup. Only the address is sent.
IP_LOCATION_API_URL=

# --- Voice calls (chat service) ---
# TURN relay for calls between networks that cannot reach each other directly
# (most calls between two mobile networks). Cloudflare dashboard > Realtime >
# TURN Server > Create: the "Turn Token ID" and its "API Token". Empty: calls
# get public STUN only and often have no audio across networks.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# --- Place search (home screen search bar) ---
# Google Cloud server key with "Places API (New)" enabled; restrict it to that
# API (and to the server's IP if it has a fixed one). Empty: search still finds
# listings and people, but suggests no places.
GOOGLE_PLACES_API_KEY=
# Countries places are searched in, comma-separated ISO codes (default kh).
GOOGLE_PLACES_REGION_CODES=kh

# --- Database (Supabase Postgres) ---
DATABASE_URL=
DIRECT_URL=
# Connections each user-service instance may open (default 10). Instances x this
# number must stay under the database's connection limit.
DATABASE_POOL_MAX=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Firebase (Google sign-in). Service account JSON on a single line ---
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Password-reset email: set ONE provider ---
BREVO_API_KEY=
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
