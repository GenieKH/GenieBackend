{
  "name": "my-app",
  "private": true,
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "db:generate": "cd .. && npx prisma generate",
