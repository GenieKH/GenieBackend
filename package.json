{
  "name": "genie-backend",
  "version": "1.0.0",
  "workspaces": [
    "shared",
    "authentication",
    "user",
    "property",
    "chat",
    "payment",
    "notification",
    "api-gateway"
  ],
  "description": "",
  "scripts": {
    "build": "npx prisma generate && npm run build --workspace=shared && npm run build --workspaces --if-present",
    "start:user": "npm run start:prod --workspace=user",
    "start:auth": "npm run start:prod --workspace=authentication",
    "start:gateway": "npm run start:prod --workspace=api-gateway",
    "test": "npm test --workspaces --if-present",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "keys:generate": "node scripts/generate-jwt-keys.js",
    "start:property": "npm run start:prod --workspace=property",
    "start:chat": "npm run start:prod --workspace=chat",
    "start:payment": "npm run start:prod --workspace=payment",
    "start:notification": "npm run start:prod --workspace=notification"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GenieKH/GenieBackend.git"
  },
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/GenieKH/GenieBackend/issues"
  },
  "homepage": "https://github.com/GenieKH/GenieBackend#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "pg": "^8.23.0",
    "prisma": "^7.9.1"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.5.0"
    }
  }
}
